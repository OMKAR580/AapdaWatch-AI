{
  "name": "aapdawatch-api",
  "version": "1.0.0",
  "description": "AapdaWatch AI - Disaster Intelligence Platform Backend API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "node scripts/run-backend-tests.mjs",
    "test:db": "node scripts/test-database-integration.mjs",
    "test:api": "node scripts/test-phase2-1-apis.mjs",
    "test:http": "node scripts/verify-http-endpoints.mjs",
    "test:all": "node scripts/run-backend-tests.mjs && node scripts/test-database-integration.mjs && node scripts/test-phase2-1-apis.mjs && node scripts/verify-http-endpoints.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
