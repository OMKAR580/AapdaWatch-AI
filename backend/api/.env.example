# AapdaWatch AI — Backend Environment Configuration Example
# Copy to .env for local development

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# PostgreSQL + PostGIS Connection String
DATABASE_URL="postgresql://aapdawatch_admin:aapdawatch_secure_pass@localhost:5433/aapdawatch_db?schema=public"

# Frontend CORS Origin
FRONTEND_ORIGIN="http://localhost:3000"

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# ML Service (FastAPI) Endpoint (Phase 3.2B BiLSTM Neural Inference Microservice)
ML_SERVICE_URL="http://localhost:8001"
ML_SERVICE_TIMEOUT_MS=3000
ENABLE_DEMO_FALLBACK=false

